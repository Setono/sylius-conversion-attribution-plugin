{# The attribution box in the sidebar of the admin order page #}
{% macro web_link(url) %}{% if url matches '{^https?://}i' %}<a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ url }}</a>{% else %}{{ url }}{% endif %}{% endmacro %}
{% import _self as attribution_box %}
{% set attribution = setono_sylius_conversion_attribution(order) %}
<div style="margin: 1em 0">
    <h4 class="ui attached styled header top">{{ 'setono_sylius_conversion_attribution.ui.attribution_heading'|trans }}</h4>
    <div class="ui attached segment">
        {%~ if attribution is null %}
        {%~ if order.clientId is defined and order.clientId is not null %}
        {{ 'setono_sylius_conversion_attribution.ui.attribution_body_without_page_view'|trans }}
        {%~ else %}
        {{ 'setono_sylius_conversion_attribution.ui.attribution_body_not_tracked'|trans }}
        {%~ endif %}
        {%~ else %}
        {%~ if attribution.direct %}
        {{ 'setono_sylius_conversion_attribution.ui.attribution_body_direct'|trans }}
        {%~ else %}
        {{ 'setono_sylius_conversion_attribution.ui.attribution_body_with_source'|trans({'%source%': attribution.source|e})|raw }}
        {%~ endif %}
        <table class="ui fixed very basic table">
            <tr>
                <td><strong>{{ 'setono_sylius_conversion_attribution.ui.source'|trans }}</strong></td>
                <td>{{ attribution.source }}</td>
            </tr>
            {%~ if attribution.medium is not null %}
            <tr>
                <td><strong>{{ 'setono_sylius_conversion_attribution.ui.medium'|trans }}</strong></td>
                <td>{{ attribution.medium }}</td>
            </tr>
            {%~ endif %}
            {%~ if attribution.campaign is not null %}
            <tr>
                <td><strong>{{ 'setono_sylius_conversion_attribution.ui.campaign'|trans }}</strong></td>
                <td>{{ attribution.campaign }}</td>
            </tr>
            {%~ endif %}
            {%~ if attribution.referrer is not null %}
            <tr>
                <td><strong>{{ 'setono_sylius_conversion_attribution.ui.referrer'|trans }}</strong></td>
                <td class="single line">{{ attribution_box.web_link(attribution.referrer) }}</td>
            </tr>
            {%~ endif %}
            {%~ if attribution.landingPage is not null %}
            <tr>
                <td><strong>{{ 'setono_sylius_conversion_attribution.ui.landing_page'|trans }}</strong></td>
                <td class="single line">{{ attribution_box.web_link(attribution.landingPage) }}</td>
            </tr>
            {%~ endif %}
            <tr>
                <td><strong>{{ 'setono_sylius_conversion_attribution.ui.when'|trans }}</strong></td>
                <td>{{ attribution.trackedAt|date('Y-m-d H:i') }}</td>
            </tr>
        </table>
        {%~ endif %}
    </div>
</div>
