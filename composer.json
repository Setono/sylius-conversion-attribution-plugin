{
    "name": "setono/sylius-conversion-attribution-plugin",
    "description": "Setono example plugin for Sylius.",
    "license": "MIT",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^2.0 || ^3.0",
        "doctrine/persistence": "^2.0 || ^3.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "setono/bot-detection-bundle": "^1.13",
        "setono/client-bundle": "^1.1",
        "setono/composite-compiler-pass": "^1.1",
        "setono/doctrine-orm-trait": "^1.0",
        "sylius/core": "^1.0",
        "sylius/core-bundle": "^1.0",
        "sylius/resource-bundle": "^1.6",
        "symfony/asset": "^6.4",
        "symfony/cache": "^6.4",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/validator": "^6.4",
        "twig/twig": "^3.21",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "api-platform/core": "^2.7.16",
        "babdev/pagerfanta-bundle": "^3.8",
        "behat/behat": "^3.14",
        "doctrine/doctrine-bundle": "^2.11",
        "jms/serializer-bundle": "^4.2",
        "lexik/jwt-authentication-bundle": "^2.17",
        "setono/sylius-plugin-pack": "~1.14.5",
        "setono/tag-bag-bundle": "^3.1",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "sylius-labs/polyfill-symfony-security": "^1.1.2",
        "symfony/debug-bundle": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/property-info": "^6.4",
        "symfony/serializer": "^6.4",
        "symfony/web-profiler-bundle": "^6.4",
        "symfony/webpack-encore-bundle": "^1.17.2",
        "willdurand/negotiation": "^3.1"
    },
    "conflict": {
        "symfony/serializer": "6.4.23"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\SyliusConversionAttributionPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\SyliusConversionAttributionPlugin\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "symfony/thanks": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
