<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" colors="true"
         bootstrap="tests/Application/config/bootstrap.php">
    <coverage includeUncoveredFiles="true" processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src/</directory>
        </include>
    </coverage>
    <testsuites>
        <testsuite name="SetonoSyliusConversionAttributionPlugin Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="test"/>
        <!-- The kernel tests use the compiled test container as is: clear tests/Application/var/cache/test after
             changing the plugin's service configuration. Mutation testing relies on it not being rebuilt -->
        <server name="APP_DEBUG" value="0" force="true"/>
        <server name="KERNEL_CLASS" value="Setono\SyliusConversionAttributionPlugin\Tests\Application\Kernel"/>
        <env name="SHELL_VERBOSITY" value="-1"/>
    </php>
    <extensions>
        <!-- Rolls back what each test writes to the database -->
        <extension class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>
</phpunit>
