--TEST--
"setono_sylius_conversion_attribution" returns the attribution of the given order only
--TEMPLATE--
{{ setono_sylius_conversion_attribution(order).source }}
--DATA--
return [
    'other' => \Setono\SyliusConversionAttributionPlugin\Tests\Twig\ExtensionTest::order('other-client', ['source' => 'facebook']),
    'order' => \Setono\SyliusConversionAttributionPlugin\Tests\Twig\ExtensionTest::order('client', ['source' => 'google']),
]
--EXPECT--
google
