--TEST--
The box shows the non-direct page view an order is credited to
--TEMPLATE--
{% include '@SetonoSyliusConversionAttributionPlugin/order/attribution.html.twig' %}
--DATA--
return ['order' => \Setono\SyliusConversionAttributionPlugin\Tests\Twig\AttributionTemplateTest::order('client', [
    'source' => 'google',
    'medium' => 'cpc',
    'campaign' => 'fall',
    'referrer' => 'https://www.google.com/',
    'landingPage' => 'https://shop.example/products/shoes',
])]
--EXPECT--
<div style="margin: 1em 0">
    <h4 class="ui attached styled header top">Attribution</h4>
    <div class="ui attached segment">
        The last non-direct visit before checkout was from <strong>google</strong>. The details are below.
        <table class="ui fixed very basic table">
            <tr>
                <td><strong>Source</strong></td>
                <td>google</td>
            </tr>
            <tr>
                <td><strong>Medium</strong></td>
                <td>cpc</td>
            </tr>
            <tr>
                <td><strong>Campaign</strong></td>
                <td>fall</td>
            </tr>
            <tr>
                <td><strong>Referrer</strong></td>
                <td class="single line"><a href="https://www.google.com/" target="_blank" rel="noopener noreferrer">https://www.google.com/</a></td>
            </tr>
            <tr>
                <td><strong>Landing page</strong></td>
                <td class="single line"><a href="https://shop.example/products/shoes" target="_blank" rel="noopener noreferrer">https://shop.example/products/shoes</a></td>
            </tr>
            <tr>
                <td><strong>When</strong></td>
                <td>2026-10-26 11:00</td>
            </tr>
        </table>
    </div>
</div>
